+	if (!susfs_sus_kstat_spoof_vfs_statfs(d_backing_inode(dentry), buf,
+						   is_fuse)) {
+		if (!buf->f_frsize)
+			buf->f_frsize = buf->f_bsize;
+		return 0;
+	}
+	ret = dentry->d_sb->s_op->statfs(dentry, buf);
+	if (!ret) {
+		buf->f_flags = calculate_f_flags(mnt);
+		if (!buf->f_frsize)
+			buf->f_frsize = buf->f_bsize;
+	}
+	return ret;
