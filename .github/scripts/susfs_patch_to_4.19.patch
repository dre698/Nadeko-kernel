+static int susfs_statfs_by_dentry(struct dentry *dentry, struct vfsmount *mnt,
+				 struct kstatfs *buf, bool *is_fuse)
+{
+	int ret;
+
+	if (!dentry->d_sb->s_op->statfs)
+		return -ENOSYS;
+	memset(buf, 0, sizeof(*buf));
+	ret = security_sb_statfs(dentry);
+	if (ret)
